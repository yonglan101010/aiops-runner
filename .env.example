# runner webhook 鉴权。AIOps Provider 的 bearer_token 必须与此值一致。
RUNNER_SHARED_TOKEN=change-me-runner-token

# Claude Code 的模型提供方配置。若使用 Anthropic 官方登录，可保持注释；若通过
# API 兼容网关运行 Claude，请填写这三项。它们只会传给 Claude 子进程，不会传给目标主机。
# ANTHROPIC_AUTH_TOKEN=change-me-anthropic-auth-token
# ANTHROPIC_BASE_URL=https://api.example.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 可选：服务用户的 claude CLI 不在标准 PATH 时，填写其所在目录。
# CLAUDE_CLI_DIR=/home/claude/.npm-global/bin

# 仅在配置 VMP/TLS 历史数据时需要；建议由配置向导写入本机 .env。
# VOLCENGINE_ACCESS_KEY_ID=change-me-volcengine-ak
# VOLCENGINE_ACCESS_KEY_SECRET=change-me-volcengine-sk

# Linux trusted_session 显式启用后必填。所有 Runner → AIOps 回调共用该值。
RUNNER_TRUSTED_AIOPS_CALLBACK_TOKEN=change-me-trusted-callback-api-key

# 可选：覆盖 Runner 配置路径，可用相对或绝对路径；默认是 config/runner.yaml。
# RUNNER_CONFIG=config/runner.yaml

# Claude Code 认证可由 claude CLI 自己管理，或使用上方的模型提供方配置。
# 确认当前用户可以成功运行：claude -p "ping" --output-format json
