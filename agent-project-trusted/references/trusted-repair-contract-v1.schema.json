{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiops.example/schemas/trusted-repair-contract-v1.schema.json",
  "title": "AIOps trusted Claude repair session contract v1",
  "oneOf": [
    { "$ref": "#/$defs/repair_proposal" },
    { "$ref": "#/$defs/repair_session" },
    { "$ref": "#/$defs/execution_event_batch" },
    { "$ref": "#/$defs/approval_request" },
    { "$ref": "#/$defs/risk_decision_request" },
    { "$ref": "#/$defs/control_intent" },
    { "$ref": "#/$defs/control_receipt" },
    { "$ref": "#/$defs/trusted_repair_proposal_callback" },
    { "$ref": "#/$defs/terminal_callback" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_provider_id", "logical_target_id", "platform"],
      "properties": {
        "runner_provider_id": { "$ref": "#/$defs/uuid" },
        "logical_target_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "platform": { "const": "linux" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "source", "observed_at"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonempty" },
        "source": { "type": "string", "enum": ["command", "file", "metric", "log", "other"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "reference": { "type": "string", "maxLength": 2048 }
      }
    },
    "initial_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "command", "cwd", "reason", "expected_result", "expected_impact", "timeout_seconds", "high_risk", "on_failure"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "command": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "reason": { "$ref": "#/$defs/nonempty" },
        "expected_result": { "$ref": "#/$defs/nonempty" },
        "expected_impact": { "$ref": "#/$defs/nonempty" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "high_risk": { "type": "boolean" },
        "on_failure": { "type": "string", "enum": ["stop_and_reassess", "request_human_intervention"] }
      }
    },
    "verification_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "command", "success_criteria", "timeout_seconds"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "command": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "success_criteria": { "$ref": "#/$defs/nonempty" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 1800 }
      }
    },
    "repair_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "proposal_revision", "proposal_hash_algorithm_id", "proposal_hash", "diagnosis_summary", "root_cause", "evidence", "confidence", "target", "initial_commands", "expected_impact", "affected_scope", "rollback_instructions", "verification_steps", "risk_summary"],
      "properties": {
        "kind": { "const": "repair_proposal" },
        "schema_version": { "const": "1.0" },
        "proposal_revision": { "type": "integer", "minimum": 1 },
        "proposal_hash_algorithm_id": { "const": "aiops-trusted-repair-proposalhash-v1" },
        "proposal_hash": { "$ref": "#/$defs/sha256" },
        "diagnosis_summary": { "$ref": "#/$defs/nonempty" },
        "root_cause": { "$ref": "#/$defs/nonempty" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/evidence" } },
        "confidence": { "type": "string", "pattern": "^(0(\\.[0-9]{1,4})?|1(\\.0{1,4})?)$" },
        "target": { "$ref": "#/$defs/target" },
        "initial_commands": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/initial_command" } },
        "expected_impact": { "$ref": "#/$defs/nonempty" },
        "affected_scope": { "$ref": "#/$defs/nonempty" },
        "rollback_instructions": { "$ref": "#/$defs/nonempty" },
        "verification_steps": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/verification_step" } },
        "risk_summary": { "$ref": "#/$defs/nonempty" }
      }
    },
    "repair_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "session_id", "claude_session_id", "tenant_id", "run_id", "repair_id", "runner_provider_id", "logical_target_id", "status", "proposal_revision", "proposal_hash_algorithm_id", "proposal_hash", "created_at", "expires_at"],
      "properties": {
        "kind": { "const": "repair_session" },
        "schema_version": { "const": "1.0" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "claude_session_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "run_id": { "$ref": "#/$defs/uuid" },
        "repair_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "runner_provider_id": { "$ref": "#/$defs/uuid" },
        "logical_target_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "status": { "enum": ["PREPARING", "DIAGNOSING", "DISPATCH_FAILED", "DIAGNOSIS_ONLY", "DIAGNOSIS_FAILED", "PENDING_APPROVAL", "EXECUTING", "AWAITING_RISK_CONFIRMATION", "SUCCEEDED", "FAILED", "REJECTED", "EXPIRED", "CANCELLED", "MANUAL_INTERVENTION"] },
        "proposal_revision": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "proposal_hash_algorithm_id": { "oneOf": [{ "const": "aiops-trusted-repair-proposalhash-v1" }, { "type": "null" }] },
        "proposal_hash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "approved_by": { "type": ["string", "null"], "maxLength": 255 },
        "approved_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "started_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "finished_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "terminal_reason": { "type": ["string", "null"], "maxLength": 4096 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["claude", "runner", "aiops_user", "feishu_user", "system"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "aiops_user_id": { "type": "string", "maxLength": 255 },
        "feishu_open_id": { "type": "string", "maxLength": 255 }
      }
    },
    "plan_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_type", "original_step", "actual_command", "reason", "observed_state", "expected_effect", "created_at"],
      "properties": {
        "change_type": { "enum": ["added", "modified", "removed"] },
        "original_step": { "type": ["integer", "null"], "minimum": 1 },
        "actual_command": { "type": ["string", "null"], "maxLength": 32768 },
        "reason": { "$ref": "#/$defs/nonempty" },
        "observed_state": { "$ref": "#/$defs/nonempty" },
        "expected_effect": { "$ref": "#/$defs/nonempty" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "risk_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_confirmation_id", "command", "reason", "affected_scope", "rollback_instructions", "consequence_if_not_executed", "requested_at", "expires_at"],
      "properties": {
        "risk_confirmation_id": { "$ref": "#/$defs/uuid" },
        "command": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "reason": { "$ref": "#/$defs/nonempty" },
        "affected_scope": { "$ref": "#/$defs/nonempty" },
        "rollback_instructions": { "$ref": "#/$defs/nonempty" },
        "consequence_if_not_executed": { "$ref": "#/$defs/nonempty" },
        "requested_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "execution_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "session_id", "event_sequence", "event_type", "event_fingerprint", "occurred_at", "actor"],
      "properties": {
        "event_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "event_sequence": { "type": "integer", "minimum": 1 },
        "event_type": { "enum": ["session_created", "diagnosis_started", "tool_started", "tool_finished", "diagnosis_completed", "proposal_created", "approval_granted", "approval_rejected", "approval_expired", "execution_resumed", "command_started", "command_finished", "plan_delta", "risk_confirmation_requested", "risk_confirmation_granted", "risk_confirmation_rejected", "risk_confirmation_expired", "verification_started", "verification_finished", "session_cancelled", "session_finished", "session_failed", "session_interrupted"] },
        "event_fingerprint": { "$ref": "#/$defs/sha256" },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "command_redacted": { "type": ["string", "null"], "maxLength": 32768 },
        "command_fingerprint": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "cwd": { "type": ["string", "null"], "maxLength": 4096 },
        "target": { "oneOf": [{ "$ref": "#/$defs/target" }, { "type": "null" }] },
        "exit_code": { "type": ["integer", "null"] },
        "stdout_summary": { "type": ["string", "null"], "maxLength": 16384 },
        "stderr_summary": { "type": ["string", "null"], "maxLength": 16384 },
        "plan_delta": { "oneOf": [{ "$ref": "#/$defs/plan_delta" }, { "type": "null" }] },
        "risk_confirmation": { "oneOf": [{ "$ref": "#/$defs/risk_confirmation" }, { "type": "null" }] },
        "actor": { "$ref": "#/$defs/actor" },
        "metadata": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": ["string", "integer", "boolean", "null"] } }
      }
    },
    "execution_event_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "tenant_id", "run_id", "repair_id", "session_id", "runner_provider_id", "runner_instance_id", "first_sequence", "last_sequence", "events"],
      "properties": {
        "kind": { "const": "execution_event_batch" },
        "schema_version": { "const": "1.0" },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "run_id": { "$ref": "#/$defs/uuid" },
        "repair_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "session_id": { "$ref": "#/$defs/uuid" },
        "runner_provider_id": { "$ref": "#/$defs/uuid" },
        "runner_instance_id": { "$ref": "#/$defs/uuid" },
        "first_sequence": { "type": "integer", "minimum": 1 },
        "last_sequence": { "type": "integer", "minimum": 1 },
        "events": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/execution_event" } }
      }
    },
    "approval_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "session_id", "proposal_revision", "proposal_hash_algorithm_id", "proposal_hash", "idempotency_key"],
      "properties": {
        "kind": { "const": "approval_request" },
        "schema_version": { "const": "1.0" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "proposal_revision": { "type": "integer", "minimum": 1 },
        "proposal_hash_algorithm_id": { "const": "aiops-trusted-repair-proposalhash-v1" },
        "proposal_hash": { "$ref": "#/$defs/sha256" },
        "idempotency_key": { "$ref": "#/$defs/uuid" }
      }
    },
    "risk_decision_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "session_id", "risk_confirmation_id", "idempotency_key"],
      "properties": {
        "kind": { "const": "risk_decision_request" },
        "schema_version": { "const": "1.0" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "risk_confirmation_id": { "$ref": "#/$defs/uuid" },
        "reason": { "type": "string", "maxLength": 4096 },
        "idempotency_key": { "$ref": "#/$defs/uuid" }
      }
    },
    "control_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "command_id", "tenant_id", "run_id", "repair_id", "session_id", "runner_provider_id", "runner_instance_id", "logical_target_id", "platform", "action", "desired_terminal", "reason_code", "requested_at", "expires_at", "intent_hash_algorithm_id", "intent_hash"],
      "properties": {
        "kind": { "const": "control_intent" },
        "schema_version": { "const": "1.0" },
        "command_id": { "$ref": "#/$defs/uuid" },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "run_id": { "$ref": "#/$defs/uuid" },
        "repair_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "session_id": { "$ref": "#/$defs/uuid" },
        "runner_provider_id": { "$ref": "#/$defs/uuid" },
        "runner_instance_id": { "$ref": "#/$defs/uuid" },
        "logical_target_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "platform": { "const": "linux" },
        "action": { "enum": ["CLOSE_WAITING_SESSION", "STOP_ACTIVE_SESSION"] },
        "desired_terminal": { "enum": ["REJECTED", "EXPIRED", "CANCELLED", "MANUAL_INTERVENTION"] },
        "reason_code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requested_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "intent_hash_algorithm_id": { "const": "aiops-trusted-repair-control-intent-hash-v1" },
        "intent_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "control_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "receipt_id", "command_id", "tenant_id", "run_id", "repair_id", "session_id", "runner_provider_id", "runner_instance_id", "logical_target_id", "platform", "intent_hash_algorithm_id", "intent_hash", "outcome", "reason_code", "command_result_certain", "prior_outcome", "prior_command_result_certain", "observed_at", "receipt_fingerprint"],
      "properties": {
        "kind": { "const": "control_receipt" },
        "schema_version": { "const": "1.0" },
        "receipt_id": { "$ref": "#/$defs/uuid" },
        "command_id": { "$ref": "#/$defs/uuid" },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "run_id": { "$ref": "#/$defs/uuid" },
        "repair_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "session_id": { "$ref": "#/$defs/uuid" },
        "runner_provider_id": { "$ref": "#/$defs/uuid" },
        "runner_instance_id": { "$ref": "#/$defs/uuid" },
        "logical_target_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "platform": { "const": "linux" },
        "intent_hash_algorithm_id": { "const": "aiops-trusted-repair-control-intent-hash-v1" },
        "intent_hash": { "$ref": "#/$defs/sha256" },
        "outcome": { "enum": ["CLOSED", "STOPPED_CONFIRMED", "ALREADY_APPLIED", "STOP_UNCERTAIN", "INVALID_INTENT"] },
        "reason_code": { "enum": ["CONTROL_APPLIED", "ALREADY_APPLIED", "STOP_UNCERTAIN", "INTENT_CONFLICT", "INTENT_EXPIRED", "INVALID_INTENT"] },
        "command_result_certain": { "type": "boolean" },
        "prior_outcome": { "oneOf": [{ "enum": ["CLOSED", "STOPPED_CONFIRMED", "STOP_UNCERTAIN", "INVALID_INTENT"] }, { "type": "null" }] },
        "prior_command_result_certain": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "receipt_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "trusted_repair_proposal_callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "tenant_id", "run_id", "repair_id", "session_id", "runner_provider_id", "runner_instance_id", "proposal"],
      "properties": {
        "kind": { "const": "trusted_repair_proposal_callback" },
        "schema_version": { "const": "1.0" },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "run_id": { "$ref": "#/$defs/uuid" },
        "repair_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "session_id": { "$ref": "#/$defs/uuid" },
        "runner_provider_id": { "$ref": "#/$defs/uuid" },
        "runner_instance_id": { "$ref": "#/$defs/uuid" },
        "proposal": { "$ref": "#/$defs/repair_proposal" }
      }
    },
    "terminal_callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "tenant_id", "run_id", "repair_id", "session_id", "runner_provider_id", "runner_instance_id", "status", "terminal_reason", "last_event_sequence", "finished_at"],
      "properties": {
        "kind": { "const": "terminal_callback" },
        "schema_version": { "const": "1.0" },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "run_id": { "$ref": "#/$defs/uuid" },
        "repair_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "session_id": { "$ref": "#/$defs/uuid" },
        "runner_provider_id": { "$ref": "#/$defs/uuid" },
        "runner_instance_id": { "$ref": "#/$defs/uuid" },
        "status": { "enum": ["DIAGNOSIS_ONLY", "DIAGNOSIS_FAILED", "SUCCEEDED", "FAILED", "REJECTED", "EXPIRED", "CANCELLED", "MANUAL_INTERVENTION"] },
        "terminal_reason": { "$ref": "#/$defs/nonempty" },
        "last_event_sequence": { "type": "integer", "minimum": 1 },
        "finished_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
